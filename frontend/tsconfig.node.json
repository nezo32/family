{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // `eslint.config.js` is deliberately absent. `allowJs` is off, so a `.js`
  // path here is dropped from the program silently — it never was typechecked
  // — and the entry is a trap: the day this config gains a type-aware ESLint
  // preset, its project service asks for a program containing that file, does
  // not find one, and `eslint .` dies with a parsing error. That is exactly
  // what `backend/tsconfig.json` did, and it failed CI on every push.
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
