# infra/backup-pull/.env — optional. Copy to `.env` beside this file only if a
# default is wrong for you. Every value here is already the default.
#
# This is NOT the application's .env. It configures the backup-pull container
# that runs on your PC, and it holds no secrets — the only secret involved is
# the SSH private key, which stays in ~/.ssh and is mounted, never copied here.

# Where backups land on this PC. Windows paths are fine.
#BACKUP_DEST=C:\Users\you\Backups\family

# The private key trusted by familybackup@nezo.su. Create it with:
#   ssh-keygen -t ed25519 -f $env:USERPROFILE\.ssh\family_backup -N '""' -C family-backup
#BACKUP_SSH_KEY=C:\Users\you\.ssh\family_backup

# The timezone PREFERRED_HOUR is measured in.
#TZ=Europe/Moscow

# Where to pull from.
#SERVER_HOST=nezo.su
#SERVER_USER=familybackup
#REMOTE_DIR=/opt/family/backups

# Rotation for the DATABASE. 7 = one file per weekday, each overwritten once a
# week: the set never grows. 1 = a single file overwritten every run (you lose
# the ability to fall back if the newest dump turns out to be bad).
#GENERATIONS=7

# Rotation for the OBJECT STORE. Objects are immutable and content-addressed, so
# they are pulled incrementally into one mirror rather than into weekday copies
# of identical bytes. What bounds it is the attic: anything that vanishes from
# the server is moved to _attic/<date>/ instead of being deleted, and dated sets
# past ATTIC_KEEP_DAYS are removed.
#
# Do not set ATTIC_KEEP_DAYS below 30 without meaning to. It is the window in
# which you can still recover from the server losing its volume, and 30 matches
# the media sweep's own grace period.
#ATTIC_KEEP_DAYS=30

# Deletions above this count in one run get a banner in the log. Nothing is
# lost either way — the attic has them — but a family does not delete four
# hundred photographs in a day.
#ATTIC_ALERT_FILES=100

# The object store's own interval, separate from the dump's because the two
# change at completely different rates. The default is the same ~daily rhythm:
# a weekly cadence made sense when a run re-fetched the whole tarball, but the
# transfer is incremental now, and a longer interval only means new photographs
# living nowhere but the VDI for up to that long. 168 = weekly, for a metered
# connection.
#OBJECTS_MIN_INTERVAL_HOURS=20

# The schedule. A backup happens when it has been at least MIN_INTERVAL_HOURS
# since the last good one AND it is past PREFERRED_HOUR — or unconditionally
# once it has been MAX_INTERVAL_HOURS, which is the "the PC was off" case.
#MIN_INTERVAL_HOURS=20
#PREFERRED_HOUR=14
#MAX_INTERVAL_HOURS=26

# How often the container wakes up to ask the question above.
#CHECK_CRON=7 * * * *

# The container reports itself unhealthy past these ages — separately, so that a
# dump arriving nightly cannot mask photographs that stopped three weeks ago.
#STALE_HOURS=48
#OBJECTS_STALE_HOURS=96
