# ─────────────────────────────────────────────────────────────
# Family App — global infrastructure environment
# Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- General ---
NODE_ENV=production
TZ=Europe/Moscow
# Public origin the app is served from (used for OAuth redirect URIs, CORS, cookies)
APP_PUBLIC_URL=https://family.example.com
APP_DOMAIN=family.example.com
# Let's Encrypt account address. Caddy refuses to start with an empty `email`,
# so compose fails fast if this is unset.
ACME_EMAIL=admin@example.com

# --- Postgres ---
POSTGRES_USER=family
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=family
POSTGRES_PORT=5432
DATABASE_URL=postgres://family:change_me_strong_password@postgres:5432/family

# --- Redis (BullMQ scheduler / notification queue) ---
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# --- Backend ---
BACKEND_PORT=3000
# 64+ char random secrets: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
COOKIE_SECRET=change_me
# Encryption key for OAuth tokens at rest: `openssl rand -base64 32`
ENCRYPTION_KEY=change_me

# --- Web Push (VAPID) --- generate with: pnpm --filter backend run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: Apple ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Base64 of the .p8 private key file: `base64 -w0 AuthKey_XXXX.p8`
APPLE_PRIVATE_KEY_BASE64=

# --- OAuth: Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Bootstrap: the first user with this email is auto-approved as owner ---
BOOTSTRAP_OWNER_EMAIL=

# --- Frontend build-time ---
VITE_API_URL=/api
VITE_VAPID_PUBLIC_KEY=
VITE_TELEGRAM_BOT_USERNAME=
