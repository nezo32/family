# ─────────────────────────────────────────────────────────────
# Family App — global infrastructure environment
# Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- General ---
NODE_ENV=production
TZ=Europe/Moscow
# Public origin the app is served from (used for OAuth redirect URIs, CORS, cookies)
APP_PUBLIC_URL=https://family.example.com
APP_DOMAIN=family.example.com
# Let's Encrypt account address. Caddy refuses to start with an empty `email`,
# so compose fails fast if this is unset.
ACME_EMAIL=admin@example.com

# --- Postgres ---
POSTGRES_USER=family
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=family
POSTGRES_PORT=5432
DATABASE_URL=postgres://family:change_me_strong_password@postgres:5432/family

# --- Redis (BullMQ scheduler / notification queue) ---
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# --- Object storage (RustFS, S3-compatible) — user avatars ---
# The `rustfs` service lives on the internal `data` network: no host port, and
# Caddy proxies nothing to it. Avatars reach the family through the backend
# (`GET /api/users/:id/avatar`), so they stay behind the session.
#
# These two are what the CONTAINER reads. They are required — compose refuses
# to start without them rather than falling back to the image's well-known
# `rustfsadmin`/`rustfsadmin` default. Generate with: openssl rand -hex 16
RUSTFS_ACCESS_KEY=change_me_storage_access_key
RUSTFS_SECRET_KEY=change_me_storage_secret_key
#
# These are what the BACKEND reads. S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# must equal RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY above — they are the same
# credential seen from the two ends of the connection.
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY_ID=change_me_storage_access_key
S3_SECRET_ACCESS_KEY=change_me_storage_secret_key
S3_BUCKET=family-media
# RustFS ignores the region; the AWS SDK refuses to sign a request without one.
S3_REGION=us-east-1
# Path-style addressing. Leave this on: virtual-hosted style would try to
# resolve `family-media.rustfs` in DNS, which exists only on AWS.
S3_FORCE_PATH_STYLE=true
# Server-side cap on an uploaded avatar. The browser resizes to 512x512 WebP
# before uploading, so real uploads are ~30-80 KB; this is the abuse ceiling.
AVATAR_MAX_BYTES=2097152
# Dev only (infra/docker-compose.dev.yml publishes these on 127.0.0.1).
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Backend ---
BACKEND_PORT=3000
# 64+ char random secrets: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
COOKIE_SECRET=change_me
# Encryption key for OAuth tokens at rest: `openssl rand -base64 32`
ENCRYPTION_KEY=change_me

# --- Web Push (VAPID) --- generate with: pnpm --filter backend run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- OAuth: Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Bootstrap: the first user with this email is auto-approved as owner ---
BOOTSTRAP_OWNER_EMAIL=

# --- Frontend build-time ---
# Origin the API lives on, WITHOUT the /api path — the client adds that itself.
# Empty means same origin, which is the normal self-hosted setup behind Caddy.
# Setting this to `/api` produces requests to `/api/api/...` and breaks everything.
VITE_API_URL=
VITE_VAPID_PUBLIC_KEY=
VITE_TELEGRAM_BOT_USERNAME=

# Dev only: where the Vite dev server proxies /api. Override if port 3000
# is already taken on your machine.
VITE_API_PROXY_TARGET=http://localhost:3000
