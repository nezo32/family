# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# @family/backend — Fastify 5 API
#
# BUILD CONTEXT IS THE REPOSITORY ROOT, not `backend/`:
#     docker build -f backend/Dockerfile -t family-backend .
# A pnpm workspace install requires pnpm-lock.yaml + pnpm-workspace.yaml +
# every workspace manifest, none of which live under backend/.
# ─────────────────────────────────────────────────────────────────────────────

ARG NODE_IMAGE=node:24.19.0-alpine3.24

# ─────────────────────────────────────────────────────────────
# base — node + pnpm (via corepack) + tini
# ─────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS base

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true

# tini reaps zombies and forwards SIGTERM/SIGINT so Fastify's close-with-grace
# actually runs on `docker stop`. Node as PID 1 ignores default-disposition
# signals, which turns every graceful shutdown into a 10s SIGKILL.
RUN apk add --no-cache tini

WORKDIR /app

# `corepack install` (no args) reads `packageManager` from ./package.json, so the
# pnpm version is pinned by the repo and never duplicated in this Dockerfile.
COPY package.json ./
RUN corepack enable && corepack install

# ─────────────────────────────────────────────────────────────
# manifests — every workspace manifest + the lockfile, nothing else.
# Isolated so that a source-only change never invalidates the install layers.
#
# NOTE: frontend/package.json is copied even though the backend does not need
# it. `--frozen-lockfile` verifies the lockfile against the *set of workspace
# importers it can see*; hiding a project that the lockfile knows about makes
# pnpm consider the lockfile out of date.
# ─────────────────────────────────────────────────────────────
FROM base AS manifests

COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY backend/package.json         ./backend/
COPY frontend/package.json        ./frontend/

# ─────────────────────────────────────────────────────────────
# deps — full (dev + prod) install for the backend and everything it depends on
# ─────────────────────────────────────────────────────────────
FROM manifests AS deps

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --filter "@family/backend..."

# ─────────────────────────────────────────────────────────────
# build — compile @family/shared, then @family/backend
# ─────────────────────────────────────────────────────────────
FROM deps AS build

COPY packages/shared ./packages/shared
COPY backend ./backend

# shared must be built first: backend's tsc resolves @family/shared through the
# workspace symlink to packages/shared/dist/index.d.ts.
RUN pnpm --filter "@family/shared" run build \
 && pnpm --filter "@family/backend" run build

# drizzle-kit migration SQL lives in backend/drizzle/ and is generated by
# `db:generate` outside Docker. It may legitimately not exist yet, and COPY has
# no "optional source" — so guarantee the directory exists here and copy it
# unconditionally into the runtime stage below.
RUN mkdir -p /app/backend/drizzle

# ─────────────────────────────────────────────────────────────
# prod-deps — the SAME install, pruned to production dependencies.
# Built from `manifests` (not from `build`) so it stays a small parallel branch.
# ─────────────────────────────────────────────────────────────
FROM manifests AS prod-deps

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --prod --filter "@family/backend..."

# ─────────────────────────────────────────────────────────────
# runtime — slim final image
#
# ── THE pnpm-IN-DOCKER TRAP, AND HOW THIS SOLVES IT ─────────────────────────
# pnpm's isolated node_modules is a graph of RELATIVE symlinks:
#
#   /app/backend/node_modules/fastify        -> ../../node_modules/.pnpm/fastify@5.../node_modules/fastify
#   /app/backend/node_modules/@family/shared -> ../../packages/shared        <-- workspace link
#   /app/packages/shared/node_modules/zod    -> ../../../node_modules/.pnpm/zod@.../node_modules/zod
#
# Naively copying only `backend/dist` + `backend/node_modules` produces an image
# where `import '@family/shared'` resolves to a dangling symlink and the process
# dies with ERR_MODULE_NOT_FOUND on the first import.
#
# Three rules make it work, and all three are enforced below:
#   1. Keep the ABSOLUTE paths identical to the build stage (/app/...), because
#      every link is relative to the workspace root layout.
#   2. Copy ALL THREE node_modules trees — the root virtual store
#      (/app/node_modules, which contains .pnpm), the backend's links, and
#      shared's own links. Docker COPY preserves symlinks as symlinks, so the
#      graph survives intact.
#   3. Copy packages/shared/package.json AND packages/shared/dist, so the
#      workspace symlink lands on a directory whose `exports` actually point at
#      compiled JS. (`pnpm deploy` is the alternative; it is deliberately not
#      used here — its semantics changed across pnpm 9/10/11 and now hinges on
#      `inject-workspace-packages`, so an explicit copy is the reproducible one.)
# ─────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS runtime

RUN apk add --no-cache tini

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    NODE_OPTIONS=--enable-source-maps

WORKDIR /app

# --- rule 2: the three node_modules trees, at their original paths ---
COPY --from=prod-deps --chown=node:node /app/node_modules                 ./node_modules
COPY --from=prod-deps --chown=node:node /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=prod-deps --chown=node:node /app/backend/node_modules         ./backend/node_modules

# --- rule 3: manifests + compiled output behind the workspace link ---
COPY --from=prod-deps --chown=node:node /app/package.json                 ./package.json
COPY --from=prod-deps --chown=node:node /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build     --chown=node:node /app/packages/shared/dist         ./packages/shared/dist

# --- the application itself ---
COPY --from=prod-deps --chown=node:node /app/backend/package.json ./backend/package.json
COPY --from=build     --chown=node:node /app/backend/dist         ./backend/dist
COPY --from=build     --chown=node:node /app/backend/drizzle      ./backend/drizzle

# --- rule 1: cwd is the backend package, absolute layout preserved ---
WORKDIR /app/backend

# `node` (uid/gid 1000) ships with the official image; never run the API as root.
USER node

EXPOSE 3000

# busybox wget is already present in alpine — no curl layer needed.
# /health is the liveness probe (process is up); /ready is the readiness probe
# (Postgres + Redis reachable) and is what the deploy workflow gates on.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/health" || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]
